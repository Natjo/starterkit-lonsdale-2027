      "default": "Lorem ipsum dolor sit amet"
    },
    {
      "name": "text",
      "label": "Texte",
      "type": "wysiwyg",
      "required": false,
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
    },
    {
      "name": "image",
      "label": "Image",
      "type": "image",
      "required": false,
      "default": {
        "__forgeStarterMediaPath": "assets/img/placeholders/content-column-1.jpg",
        "name": "content-column-1.jpg"
      }
    },
    {
      "name": "images",
      "label": "Images responsive",
      "type": "group",
      "required": false,
      "children": [
        {
          "name": "desktop",
          "label": "Desktop",
          "type": "image",
          "return_format": "id",
          "required": false,
          "default": {
            "__forgeStarterMediaPath": "assets/img/placeholders/content-column-1.jpg",
            "name": "content-column-1.jpg"
          }
        },
        {
          "name": "mobile",
          "label": "Mobile",
          "type": "image",
          "return_format": "id",
          "required": false,
          "default": {
            "__forgeStarterMediaPath": "assets/img/placeholders/hero-homepage-mobile.jpg",
            "name": "hero-homepage-mobile.jpg"
          }
        }
      ]
    },
    {
      "name": "image_size",
      "label": "Taille de l’image",
      "type": "text",
      "required": false,
      "default": "full"
    },
    {
      "name": "link",
      "label": "Lien",
      "type": "link",
      "required": false,
      "default": {
        "url": "/",
        "title": "En savoir plus",
        "target": ""
      }
    }
