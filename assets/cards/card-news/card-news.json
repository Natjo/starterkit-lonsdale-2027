  "fields": [
    {
      "name": "date",
      "label": "Date",
      "type": "text",
      "required": false,
      "default": "1 janvier 2026"
    },
    {
      "name": "datetime",
      "label": "Date machine",
      "type": "text",
      "required": false,
      "default": "2026-01-01"
    },
    {
      "name": "title",
      "label": "Titre",
      "type": "text",
