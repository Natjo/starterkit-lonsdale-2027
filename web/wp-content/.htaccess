# Proteger le repertoire wp-content
Require all denied

<Files ~ ".(xml|css|css.map|jpe?g|png|gif|js|pdf|eot|svg|ttf|woff|woff2|svg|ico|mp4|ogv|ogg|mp3|mov|webm|webp|json|twig|webmanifest|map)$">
    Require all granted
    Header set Access-Control-Allow-Origin "*"
</Files>

# Cache long des assets. Leurs URLs sont versionnees (?ver=filemtime pour les
# entrees et les CSS split, nom de fichier hashe pour les chunks JS) : un
# deploiement change l'URL et invalide le cache sans attendre l'expiration.
# Les formats a duree de vie incertaine (json, xml, webmanifest) restent exclus.
<FilesMatch "\.(css|js|jpe?g|png|gif|svg|ico|webp|avif|eot|ttf|woff|woff2|mp4|ogv|ogg|mp3|mov|webm|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
